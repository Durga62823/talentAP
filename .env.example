# Copy to .env in the repository root (git-ignored).
# SENTINEL_DATASET_DIR=./Datasets

# ---------------------------------------------------------------- MySQL Backend (Optional)
SENTINEL_MYSQL_HOST=localhost
SENTINEL_MYSQL_PORT=3306
SENTINEL_MYSQL_ADMIN_USER=root
SENTINEL_MYSQL_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- PostgreSQL Backend (Optional)
SENTINEL_DEMO_PG_HOST=localhost
SENTINEL_DEMO_PG_PORT=5432
SENTINEL_DEMO_PG_DB=saffron_bank
SENTINEL_DEMO_PG_USER=sentinel_app
SENTINEL_DEMO_PG_PASSWORD=change-me

# ---------------------------------------------------------------- Security & Limits
SENTINEL_ENV=demo
SENTINEL_ALLOWED_DB_HOSTS=localhost,127.0.0.1
SENTINEL_MAX_ROWS=500
SENTINEL_QUERY_TIMEOUT_MS=5000
SENTINEL_MIN_GROUP_SIZE=5
SENTINEL_MAX_UPLOAD_BYTES=5242880
SENTINEL_UPLOAD_RETENTION_MIN=60
SENTINEL_JURISDICTIONS=US,IN,UK
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ---------------------------------------------------------------- Gemini AI classification (optional)
# Backend only. Never put this key in FULL_CODE/frontend or any VITE_* variable.
# Without a key, scans use the rule-based engine only and show "AI unavailable".

# AI upgrades below this confidence are shown as "Review required" and not applied.
