# ==============================================================================
# Git Ignore - Dream Guard / SentinelMask
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pw
*.pem
*.cert
*.crt
*.pfx
*.p12
*.secret

# ------------------------------------------------------------------------------
# 2. Datasets, Databases & Local Runtime Storage
# ------------------------------------------------------------------------------
# Official hackathon dataset pack (obtain directly from organisers)
Datasets/
datasets/

# Runtime state: SQLite targets, meta DBs, temp uploads, generated secrets
data/
backups/

# Database files & journals
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Data tables & SQL dumps (schema files without data stay tracked)
*.csv
*.tsv
*.parquet
*_data.sql
*dump*.sql
*.sql.bak

# ------------------------------------------------------------------------------
# 3. Python Runtime, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
FULL_CODE/backend/.venv/

# Testing & Coverage
.pytest_cache/
FULL_CODE/backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checking & Linting
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!**/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
FULL_CODE/frontend/node_modules/
FULL_CODE/frontend/dist/
dist/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Operating System Junk
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 6. IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
\#*\#

# VS Code (preserve shared configuration if any, ignore personal cache)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.pid
